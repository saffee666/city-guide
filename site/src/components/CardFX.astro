---
/**
 * CardFX —— 全息倾斜 + 金光 glow + 点击涟漪（vanilla 移植自源站 collections 页）
 * 选择器 .cardfx-target；仅桌面端启用（≤768px 跳过）
 */
---

<script>
  (function () {
    var SEL = '.cardfx-target';
    if (window.matchMedia && window.matchMedia('(max-width:768px)').matches) return;
    function ripple(el, e) {
      var r = el.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
      var md = Math.max(Math.hypot(x, y), Math.hypot(x - r.width, y), Math.hypot(x, y - r.height), Math.hypot(x - r.width, y - r.height));
      var d = document.createElement('span'); d.className = 'fx-ripple';
      d.style.width = d.style.height = (md * 2) + 'px'; d.style.left = (x - md) + 'px'; d.style.top = (y - md) + 'px';
      el.appendChild(d); requestAnimationFrame(function () { d.style.transform = 'scale(1)'; d.style.opacity = '0'; });
      setTimeout(function () { d.remove(); }, 740);
    }
    function ensure(el) {
      if (el.dataset.fx) return; el.dataset.fx = '1';
      if (getComputedStyle(el).position === 'static') el.style.position = 'relative';
      el.classList.add('cardfx');
      var h = document.createElement('span'); h.className = 'fx-holo'; el.appendChild(h);
      var g = document.createElement('span'); g.className = 'fx-glow'; el.appendChild(g);
      el.addEventListener('mousemove', function (e) {
        var r = el.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        el.style.setProperty('--px', (px * 100).toFixed(1));
        el.style.setProperty('--py', (py * 100).toFixed(1));
        el.style.setProperty('--gi', '1');
        var ry = (px - 0.5) * 13, rx = -(py - 0.5) * 13;
        el.style.transform = 'perspective(900px) rotateX(' + rx.toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg) translateY(-4px)';
      });
      el.addEventListener('mouseleave', function () { el.style.transform = ''; el.style.setProperty('--gi', '0'); });
      el.addEventListener('click', function (e) { ripple(el, e); });
    }
    function init() { document.querySelectorAll(SEL).forEach(ensure); }
    if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<style is:global>
  .cardfx { transition: transform .16s ease-out; will-change: transform; transform-style: preserve-3d; --px: 50; --py: 50; --gi: 0; }
  .cardfx .fx-holo {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 5;
    opacity: calc(var(--gi) * .5); transition: opacity .35s ease;
    background: linear-gradient(110deg, transparent 22%, rgba(255,110,170,.55), rgba(120,140,255,.55), rgba(120,255,205,.55), rgba(255,225,120,.55), transparent 78%);
    background-size: 220% 220%; background-position: calc(var(--px) * 1%) calc(var(--py) * 1%);
    mix-blend-mode: overlay;
  }
  .cardfx .fx-glow {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 6; padding: 2.5px;
    background: radial-gradient(230px circle at calc(var(--px) * 1%) calc(var(--py) * 1%),
      rgba(216, 150, 72, calc(var(--gi) * .95)) 0%, rgba(216, 150, 72, calc(var(--gi) * .4)) 35%, transparent 62%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude; transition: opacity .3s;
  }
  .cardfx .fx-ripple {
    position: absolute; border-radius: 50%; pointer-events: none; z-index: 7;
    background: radial-gradient(circle, rgba(216,150,72,.4) 0%, rgba(216,150,72,.2) 30%, transparent 70%);
    transform: scale(0); opacity: 1; transition: transform .7s ease-out, opacity .7s ease-out;
  }
  @media (prefers-reduced-motion: reduce) { .cardfx { transition: none; } }
</style>
