  /* ===== 活地图（CTC way-map 排版规格 + 自绘水彩地图） ===== */
  .ways { position: relative; }
  .way-map {
    position: relative; display: flex; align-items: center; min-height: 480px;
    border-radius: var(--r); overflow: hidden; border: 1px solid var(--line);
