  .cell:hover .fname { opacity: 1; transform: translateX(-50%); }
  .cell.today { outline: 2px solid var(--cinnabar); outline-offset: -1px; color: var(--cinnabar); font-weight: 800; }
  .cal-legend { display: flex; gap: 16px; margin-top: 12px; font-size: 11px; color: var(--ink-faint); }
  .cal-legend .lg { display: flex; align-items: center; gap: 5px; }
  .cal-legend .lg::before { content: ''; width: 9px; height: 9px; border-radius: 50%; }
  .cal-legend .fest::before { background: var(--cinnabar); }
  .cal-legend .holi::before { background: rgba(200, 64, 47, 0.3); border-radius: 3px; }
  .cal-note { margin-top: 14px; font-size: 13px; color: var(--ink-soft); background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--ink-faint); border-radius: 10px; padding: 10px 14px; line-height: 1.5; box-shadow: var(--shadow-1); }
