  /* ===== 目的地卡 ===== */
  .dest-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .dest { border-radius: var(--r); overflow: hidden; background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow-2); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); display: block; }
