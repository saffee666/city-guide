  .craft .mono { font-size: 9px; color: var(--ink-faint); }
  .craft h3 { font-size: 16px; font-weight: 500; color: var(--ink); margin-top: 2px; }
  @media (max-width: 920px) { .heritage-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .heritage-grid { grid-template-columns: repeat(2, 1fr); } }
  .more-row { margin-top: 26px; }
  .more-link { font-size: 12px; color: var(--cinnabar); border-bottom: 1px solid var(--line-strong); padding-bottom: 3px; transition: 0.25s; }
  .more-link:hover { color: var(--cinnabar-deep); border-color: var(--cinnabar); }

  /* ===== 实务 CTA ===== */
  .cta-wrap { max-width: 1280px; margin: 0 auto; padding: clamp(40px, 7vh, 90px) clamp(18px, 5vw, 64px) clamp(80px, 12vh, 140px); }
  .cta { position: relative; text-align: center; border-radius: var(--r); overflow: hidden; padding: clamp(60px, 9vh, 110px) 24px; background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow-3); }
  .cta::before { content: ''; position: absolute; left: 0; top: 0; right: 0; height: 3px; background: linear-gradient(90deg, #ffd64a, #f87f37, #ee5740, #e9577e, #b56cae, #5a86c6, #2fa6b4, #46c391); }
  .cta-inner { position: relative; z-index: 2; max-width: 660px; margin: 0 auto; }
  .cta-inner .mono { font-size: 11px; color: var(--cinnabar); }
  .cta-inner h2 {
    font-size: clamp(32px, 5.2vw, 62px); font-weight: 300; margin-top: 12px; letter-spacing: -0.02em;
    background-image: linear-gradient(100deg, #c8902f, #dd5f2c 15%, #d3372f 29%, #c23f6e 44%, #7d57a8 59%, #2f6fa6 73%, #1f8a86 86%, #2f8b5f 100%);
    background-size: 300% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
    animation: flow 14s linear infinite; line-height: 1.12; padding-bottom: 0.2em;
  }
  .cta-inner h2 em { font-style: italic; }
  .cta-inner p { margin: 20px auto 26px; max-width: 480px; line-height: 1.7; color: var(--ink-soft); }
  .cta-tags { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 32px; }
  .cta-tags span { font-size: 12px; padding: 8px 15px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink-soft); }

  /* ===== reveal ===== */
  .r { opacity: 0; transform: translateY(24px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); }
  .r.in { opacity: 1; transform: none; }
  .r.d1 { transition-delay: 0.08s; } .r.d2 { transition-delay: 0.16s; } .r.d3 { transition-delay: 0.24s; } .r.d4 { transition-delay: 0.32s; }
  @media (prefers-reduced-motion: reduce) {
    .r { opacity: 1; transform: none; transition: none; }
    .hero-bg span { animation: none; opacity: 1; }
    .hero-bg span:nth-child(1) { opacity: 1; }
    .sec-head h2, .cta-inner h2 { animation: none; }
    .marquee-track { animation: none; }
  }

  /* ph-grad（无图占位） */
  .ph-grad {
    display: grid; place-items: center; width: 100%; height: 100%;
    background:
      radial-gradient(90% 90% at 20% 15%, rgba(233, 200, 121, 0.5), transparent 60%),
      radial-gradient(80% 80% at 85% 25%, rgba(47, 125, 166, 0.4), transparent 55%),
      radial-gradient(90% 80% at 50% 100%, rgba(200, 64, 47, 0.4), transparent 60%),
      linear-gradient(150deg, #3d4d55, #22303a);
  }
</style>

<script>
  // 进度条 + reveal（CTC storyboard.js 配方）
  const prog = document.getElementById('progress');
  const onScroll = () => {
    if (prog) {
      const h = document.documentElement;
      prog.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100 + '%';
    }
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.14, rootMargin: '0px 0px -8% 0px' }
  );
  const observeAll = () => document.querySelectorAll('.r:not(.in)').forEach((el) => io.observe(el));
  observeAll();
  setTimeout(observeAll, 400);

  // 跑马灯内容复制一份实现无缝循环
  const mq = document.getElementById('marquee');
  if (mq) mq.innerHTML += mq.innerHTML;

  // ===== 节气历（2026-2027 公共历法事实表） =====
  const FESTS: Record<string, string> = {
    '2026-01-01': '元旦', '2026-02-16': '除夕', '2026-02-17': '春节', '2026-03-03': '元宵',
    '2026-02-04': '立春', '2026-02-19': '雨水', '2026-03-05': '惊蛰', '2026-03-20': '春分',
    '2026-04-05': '清明', '2026-04-20': '谷雨', '2026-05-01': '劳动节', '2026-05-05': '立夏',
    '2026-05-21': '小满', '2026-06-05': '芒种', '2026-06-19': '端午', '2026-06-21': '夏至',
    '2026-07-07': '小暑', '2026-07-22': '大暑', '2026-08-07': '立秋', '2026-08-23': '处暑',
    '2026-09-07': '白露', '2026-09-23': '秋分', '2026-09-25': '中秋', '2026-10-01': '国庆',
    '2026-10-08': '寒露', '2026-10-23': '霜降', '2026-11-07': '立冬', '2026-11-22': '小雪',
    '2026-12-07': '大雪', '2026-12-21': '冬至', '2027-01-01': '元旦', '2027-02-06': '春节',
    '2027-02-04': '立春',
  };
  const HOLIDAYS = new Set(['2026-01-01', '2026-02-16', '2026-02-17', '2026-02-18', '2026-04-05', '2026-05-01', '2026-06-19', '2026-09-25', '2026-10-01', '2026-10-02', '2026-10-03', '2026-10-04', '2026-10-05', '2026-10-06', '2026-10-07']);
  const WEEK = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  const pad = (n: number) => String(n).padStart(2, '0');
  const key = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

  const today = new Date();
  const todayK = key(today);
  const upcoming = Object.keys(FESTS).filter((k) => k >= todayK).sort();
  const nextK = upcoming[0];
  const el = (id: string) => document.getElementById(id);
  if (el('cal-date')) {
    el('cal-wk')!.textContent = WEEK[today.getDay()];
    el('cal-date')!.textContent = `${today.getMonth() + 1}月${today.getDate()}日`;
    el('cal-mo')!.textContent = `${today.getFullYear()} 年`;
    if (nextK) {
      const dn = Math.round((+new Date(nextK) - +new Date(todayK)) / 86400000);
      el('cal-next')!.innerHTML = `下一个：<b>${FESTS[nextK]}</b>（${dn === 0 ? '就是今天' : `还有 ${dn} 天`}）`;
      const season = ['立春', '春分', '立夏', '夏至', '立秋', '秋分', '立冬', '冬至'].includes(FESTS[nextK]);
      el('cal-note')!.innerHTML = season
        ? `<b>${FESTS[nextK]}</b>将至——节气换挡，出行前查好目的地天气。`
        : `<b>${FESTS[nextK]}</b>临近，热门城市会涨价也热闹；想清静就错峰，想凑趣就赶早订。`;
      el('cal-note')!.className = 'cal-note ' + (HOLIDAYS.has(nextK) ? 'busy' : season ? 'ok' : 'mid');
    }

    let view = new Date(today.getFullYear(), today.getMonth(), 1);
    const renderCal = () => {
      el('cal-month-name')!.textContent = `${view.getFullYear()} 年 ${view.getMonth() + 1} 月`;
      const grid = el('cal-grid')!;
      grid.innerHTML = '';
      const first = new Date(view.getFullYear(), view.getMonth(), 1);
      for (let i = 0; i < first.getDay(); i++) {
        const c = document.createElement('div'); c.className = 'cell pad'; grid.appendChild(c);
      }
      const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      for (let d = 1; d <= days; d++) {
        const dt = new Date(view.getFullYear(), view.getMonth(), d);
        const k = key(dt);
        const c = document.createElement('div');
        const fest = FESTS[k];
        c.className = 'cell' + (fest ? ' fest' : '') + (HOLIDAYS.has(k) ? ' holi' : '') + (k === todayK ? ' today' : '');
        c.innerHTML = `<span>${d}</span>` + (fest ? `<i class="fdot"></i><span class="fname">${fest}</span>` : '');
        grid.appendChild(c);
      }
    };
    renderCal();
    el('cal-prev')!.addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); renderCal(); });
    el('cal-next-m')!.addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); renderCal(); });
  }

  // cardfx 轻倾斜（活地图卡）
  const map = document.getElementById('way-map');
  if (map && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    map.addEventListener('pointermove', (ev) => {
      const r = (map as HTMLElement).getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width;
      const y = (ev.clientY - r.top) / r.height;
      (map as HTMLElement).style.setProperty('--px', String(Math.round(x * 100)));
      (map as HTMLElement).style.setProperty('--py', String(Math.round(y * 100)));
      (map as HTMLElement).style.setProperty('--gi', '1');
    });
    map.addEventListener('pointerleave', () => {
      (map as HTMLElement).style.setProperty('--gi', '0');
    });
  }
</script>
