  @media (max-width: 760px) {
    .way-map { display: flex; flex-direction: column; align-items: stretch; min-height: 0; }
    .way-map-vis { position: relative; order: 2; width: 100%; height: auto; aspect-ratio: 4 / 3; right: auto; }
    .way-map-text { order: 1; max-width: none; padding: 30px 26px 14px; }
