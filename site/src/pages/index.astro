  /* ===== 灵感 ===== */
  .inspire-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .inspire {
    position: relative; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line);
    box-shadow: var(--shadow-2); min-height: 230px; display: flex; align-items: flex-end; color: #fff;
    background:
      radial-gradient(90% 90% at 20% 15%, rgba(233, 200, 121, 0.4), transparent 60%),
