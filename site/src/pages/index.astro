  .inspire:hover { transform: translateY(-6px); }
  .inspire-body { position: relative; z-index: 2; padding: 20px; }
  .inspire-body .mono { font-size: 10px; color: #e9c879; }
  .inspire-body h3 { font-size: 20px; font-weight: 400; color: #fff; margin-top: 6px; }
  .inspire-body p { font-size: 12.5px; line-height: 1.5; color: rgba(255, 255, 255, 0.86); margin-top: 8px; }
  @media (max-width: 920px) { .inspire-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .inspire-grid { grid-template-columns: 1fr; } }

  /* ===== 非遗 ===== */
  .heritage-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
  .craft { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 24px 14px; border-radius: var(--r); background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow-1); transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease); }
  .craft:hover { transform: translateY(-6px); box-shadow: var(--shadow-2); }
  .craft-glyph {
