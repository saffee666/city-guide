---
/**
 * 404 —— 中文站风格迷路页（对齐全站 paper 底 + 朱砂按钮）
 */
import Layout from '~/layouts/Layout.astro';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = `迷路了 · 404`;
---

<Layout metadata={{ title }}>
  <section class="nf">
    <p class="mono">404 · NOT FOUND</p>
    <h1>这一页还没被点亮</h1>
    <p class="sub">
      你要找的页面不存在，或者还在筹备中——就像地图上那些还没去的城。
    </p>
    <div class="acts">
      <a class="go" href={`${B}/`}>回首页</a>
      <a class="ghost" href={`${B}/destinations`}>去看目的地 →</a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 72vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 60px;
    background:
      radial-gradient(120% 60% at 85% 0%, rgba(212, 169, 72, 0.07), transparent 52%),
      linear-gradient(180deg, #fbf8f1, #f9f6ee 55%, #f4f1e8);
    font-family: Inter, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    color: #211f1a;
  }
  .mono { color: #c8402f; font: 700 12px/1.4 'Space Mono', ui-monospace, monospace; letter-spacing: 0.18em; }
  h1 { font-family: Fraunces, 'Noto Serif SC', serif; font-weight: 600; font-size: clamp(30px, 5vw, 48px); margin: 16px 0 14px; }
  .sub { color: #574f44; font-size: 16px; line-height: 1.8; max-width: 460px; margin: 0 0 28px; }
  .acts { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .go { background: #c8402f; color: #fff; font-weight: 700; font-size: 14px; padding: 11px 24px; border-radius: 999px; text-decoration: none; }
  .go:hover { background: #8f2a1b; }
  .ghost { border: 1px solid rgba(33, 31, 26, 0.22); color: #211f1a; font-weight: 600; font-size: 14px; padding: 11px 24px; border-radius: 999px; text-decoration: none; }
  .ghost:hover { background: #211f1a; color: #f9f6ee; }
</style>
