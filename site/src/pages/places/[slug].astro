---
/**
 * 景点深度页模板 —— 结构与样式规格 1:1 对齐 ChinaTravelCo places/*（7 区编辑式长文）
 * 数据源：src/content/places/<slug>.json
 */
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const places = await getCollection('place');
  return places.map(({ id, data }) => ({ params: { slug: id }, props: { place: data } }));
}

const { place } = Astro.props;
const cities = await getCollection('city');
const cityLive = cities.find((c) => c.id === place.city);
const metadata = {
  title: `${place.name}旅游攻略`,
  description: place.oneline,
};
---

<Layout metadata={metadata}>
  <div class="place-page">
    <!-- 头部：loc / h1 / 中文名 / 徽章 / 一句话 -->
    <header class="ph">
      <p class="loc">{place.region} · {place.cityZh}</p>
      <h1>{place.nameEn}</h1>
      <p class="zh">{place.name}</p>
      <div class="tags">
        {place.badges.map((b) => <span class="tag">{b}</span>)}
      </div>
      <p class="oneline">{place.oneline}</p>
    </header>

    <article class="pb">
      <!-- ① 概览 -->
      <h2> Overview</h2>
      <p set:html={place.overview} />

      <!-- ② 为什么去 -->
      <h2>Why Visit</h2>
      {place.why.map((w) => (
        <div class="why">
          <b>{w.b}</b>
          <p>{w.p}</p>
        </div>
      ))}

      <!-- ③ 看什么（编号动线） -->
      <h2>What to See</h2>
      {place.sights.map((s, i) => (
        <div class="sight">
          <h3>{String(i + 1).padStart(2, '0')} · {s.name}</h3>
          <p>{s.desc}</p>
          <p class="see">{s.tip}</p>
        </div>
      ))}

      <!-- ④ 怎么逛 -->
      <h2>How to Visit</h2>
      {place.routes.map((r) => (
        <div class="route">
          <b>{r.plan}</b>
          <p>{r.detail}</p>
        </div>
      ))}

      <!-- ⑤ 实用信息 -->
      <h2>Practical Info</h2>
      <div class="prac">
        <ul>
          {place.practical.map((p) => (
            <li><b>{p.label}</b>{p.value}</li>
          ))}
        </ul>
      </div>

      <!-- ⑥ 文化注解 -->
      <h2>Cultural Notes</h2>
      <div class="cult">
        {place.culture.map((c) => <p>{c}</p>)}
      </div>

      <!-- ⑦ 周边串联 -->
      <h2>Nearby & Related</h2>
      {place.nearby.map((n) => (
        <div class="near">
          <b>{n.name}</b>
          <p>{n.desc}</p>
        </div>
      ))}

      {cityLive && (
        <p class="city-link">所属城市指南：<a href={`/cities/${place.city}`}>{place.cityZh} →</a></p>
      )}
    </article>

    <footer class="pfoot">
      <a href="/">首页</a> · <a href="/destinations">目的地</a> · <a href="/essentials">实务</a>
      <br />© 2026 城市指南 · 数据仅供参考
    </footer>
  </div>
</Layout>

<style>
  .place-page {
    --paper: #f9f6ee; --card: #fffdf8;
    --ink: #211f1a; --ink-soft: #574f44; --ink-faint: #8a8275;
    --cinnabar: #c8402f; --line: rgba(33, 31, 26, 0.12);
    --shadow-1: 0 2px 10px rgba(60, 55, 40, 0.07);
    color: var(--ink);
    background:
      radial-gradient(120% 55% at 88% -8%, rgba(212, 169, 72, 0.07), transparent 52%),
      linear-gradient(180deg, #fbf8f1, var(--paper) 55%, #f4f1e8);
    font-family: Inter, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  .place-page a { text-decoration: none; color: inherit; }

  .ph { max-width: 880px; margin: 0 auto; padding: 140px 24px 10px; }
  .ph .loc { font-family: 'Space Mono', monospace; font-size: 12px; letter-spacing: 0.14em; color: var(--ink-faint); text-transform: uppercase; }
  .ph h1 {
    font-family: Fraunces, 'Noto Serif SC', serif; font-weight: 600;
    font-size: clamp(36px, 6vw, 58px); margin: 10px 0 2px; line-height: 1.08;
  }
  .ph .zh { font-family: 'Noto Serif SC', serif; font-size: 20px; color: var(--ink-faint); }
  .ph .tags { margin: 14px 0; }
  .ph .tag {
    display: inline-block; font-size: 11.5px; font-weight: 700; color: #7c5f16;
    background: #f4df9c; border: 1px solid #d9bc62; border-radius: 999px;
    padding: 3px 12px; margin: 0 6px 6px 0;
  }
  .ph .oneline {
    font-size: 18px; line-height: 1.65; color: var(--ink); font-weight: 600;
    max-width: 780px; border-left: 3px solid var(--cinnabar); padding-left: 14px; margin: 16px 0 0;
  }

  .pb { max-width: 880px; margin: 0 auto; padding: 10px 24px 40px; }
  .pb h2 {
    font-family: Fraunces, 'Noto Serif SC', serif; font-weight: 600; font-size: 24px;
    color: var(--cinnabar); margin: 44px 0 14px; border-bottom: 1px solid var(--line); padding-bottom: 10px;
  }
  .pb p { font-size: 15.5px; line-height: 1.85; color: var(--ink-soft); max-width: 780px; margin: 0 0 14px; }
  .pb p :global(b) { color: var(--ink); }

  .why {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 14px 18px; margin: 0 0 10px; box-shadow: var(--shadow-1);
  }
  .why b { font-size: 15px; color: var(--ink); }
  .why p { font-size: 14px; margin: 6px 0 0; line-height: 1.75; }

  .sight { margin: 0 0 22px; }
  .sight h3 { font-family: Fraunces, 'Noto Serif SC', serif; font-size: 18px; margin: 0 0 8px; color: var(--ink); }
  .sight .see {
    font-size: 13px; color: #8a6a3a; background: rgba(201, 155, 63, 0.08);
    border-radius: 8px; padding: 8px 12px; max-width: 780px;
  }

  .route {
    background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--cinnabar);
    border-radius: 12px; padding: 14px 18px; margin: 0 0 12px;
  }
  .route b { font-size: 15px; color: var(--ink); }
  .route p { font-size: 14px; margin: 6px 0 0; line-height: 1.8; }

  .prac {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px 22px; box-shadow: var(--shadow-1);
  }
  .prac ul { margin: 0; padding: 0; list-style: none; }
  .prac li { font-size: 14px; line-height: 1.9; color: var(--ink-soft); padding: 3px 0; }
  .prac li b { display: inline-block; min-width: 150px; color: var(--ink); }

  .cult {
    background: rgba(47, 125, 166, 0.05); border: 1px solid rgba(47, 125, 166, 0.18);
    border-radius: 12px; padding: 6px 22px 10px; margin-top: 6px;
  }

  .near {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 12px 16px; margin: 0 0 10px;
  }
  .near b { font-size: 14.5px; color: var(--ink); }
  .near p { font-size: 13.5px; margin: 4px 0 0; line-height: 1.7; }

  .city-link { margin-top: 30px; font-size: 14.5px; color: var(--ink-soft); }
  .city-link a { color: var(--cinnabar); font-weight: 700; }

  .pfoot {
    border-top: 1px solid var(--line); padding: 26px 24px 34px;
    text-align: center; font-size: 12.5px; color: var(--ink-faint);
  }
  .pfoot a { color: var(--ink-soft); font-weight: 600; margin: 0 10px; }
</style>
