---
/**
 * 主题榜单 hub 页 —— 结构 1:1 对齐 ChinaTravelCo collections.html（hub 态）
 * hero 渐变底 + hub-lead + hub-grid 卡片流（首张 feat 加宽）+ CardFX
 * 数据源：src/data/collections.json
 */
import Layout from '~/layouts/PageLayout.astro';
import CardFX from '~/components/CardFX.astro';
import data from '~/data/collections.json';
import fs from 'node:fs';
import path from 'node:path';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
/** hub 卡复用各主题第 1 名排名卡图（构建期检测，无图保持渐变） */
const hubImg = (slug: string) =>
  fs.existsSync(path.join(process.cwd(), 'public', 'images', `collections/${slug}-1.jpg`))
    ? `${B}/images/collections/${slug}-1.jpg`
    : null;
const cards = data.order.map((slug) => ({ slug, ...data.collections[slug] }));
const metadata = {
  title: '主题榜单',
  description: data.hub.lead,
};
---

<Layout metadata={metadata}>
  <div class="col-page">
    <header class="hero">
      <div class="hero-inner">
        <p class="kicker">{data.hub.kicker}</p>
        <h1>{data.hub.title}</h1>
        <p>{data.hub.lead}</p>
      </div>
    </header>

    <section class="section">
      <div class="wrap">
        <div class="hub-lead">
          <p class="eyebrow">精选 · Top 10</p>
          <h2>把中国之最，排成榜</h2>
        </div>
        <div class="hub-grid">
          {cards.map((c, i) => (
            <a
              class={`hub-card cardfx-target${i === 0 ? ' feat' : ''}`}
              style={hubImg(c.slug) ? `background-image:url(${hubImg(c.slug)});background-size:cover;background-position:center;` : null}
              href={`${B}/collections/${c.slug}`}
            >
              <span class="bar"></span>
              <div class="t">
                <p class="eb">{data.tags[c.slug]}</p>
                <b>{c.title}</b>
                <small>{c.subtitle}</small>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <footer class="pfoot">
      <a href={`${B}/`}>首页</a> · <a href={`${B}/destinations`}>目的地</a> · <a href={`${B}/essentials`}>实务</a>
      <br />© 2026 城市指南 · 数据仅供参考
    </footer>
  </div>
  <CardFX />
</Layout>

<style>
  .col-page {
    --paper: #f9f6ee; --card: #fffdf8;
    --ink: #211f1a; --ink-soft: #574f44; --ink-faint: #8a8275;
    --red: #c8402f; --red-deep: #a5311f; --tipbg: #fbf3ef;
    --line: rgba(33, 31, 26, 0.12); --radius: 18px;
    --shadow-sm: 0 2px 10px rgba(60, 55, 40, 0.07);
    color: var(--ink);
    background: linear-gradient(180deg, #fbf8f1, var(--paper) 55%, #f4f1e8);
    font-family: Inter, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  .col-page a { text-decoration: none; color: inherit; }

  .hero {
    position: relative; min-height: 46vh; display: flex; align-items: flex-end;
    color: #fff;
    background:
      radial-gradient(120% 90% at 80% 0%, rgba(63, 178, 127, 0.35), transparent 55%),
      radial-gradient(110% 80% at 12% 8%, rgba(199, 85, 61, 0.4), transparent 52%),
      linear-gradient(160deg, #2c4a68, #22436a 55%, #173250);
  }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.62)); }
  .hero-inner { position: relative; z-index: 2; width: 100%; max-width: 1180px; margin: 0 auto; padding: 120px 28px 46px; }
  .kicker { font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.95; margin: 0 0 8px; }
  .hero h1 { font-family: Fraunces, 'Noto Serif SC', serif; font-weight: 600; font-size: clamp(34px, 5.4vw, 52px); margin: 0 0 10px; }
  .hero p { font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0; opacity: 0.95; }

  .section { padding: 56px 0; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
  .hub-lead { max-width: 780px; margin: 0 0 30px; }
  .eyebrow { color: var(--red); font: 600 13px/1.4 'Space Mono', ui-monospace, monospace; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 8px; }
  .hub-lead h2 { font-family: Fraunces, 'Noto Serif SC', serif; font-weight: 600; font-size: 30px; margin: 0; }

  .hub-grid { display: flex; flex-wrap: wrap; gap: 22px; align-items: stretch; }
  .hub-card {
    flex: 1 1 330px; position: relative; min-height: 264px; border-radius: var(--radius);
    overflow: hidden; box-shadow: var(--shadow-sm); display: flex; align-items: flex-end; color: #fff;
    background:
      radial-gradient(130% 100% at 85% 0%, rgba(216, 161, 58, 0.45), transparent 55%),
      linear-gradient(160deg, #3a6ea5, #22436a 70%);
    transition: box-shadow .25s;
  }
  .hub-card { position: relative; }
  .hub-card::before {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.05) 45%, rgba(0, 0, 0, 0.58) 100%);
  }
  .hub-card:hover { box-shadow: 0 18px 44px rgba(55, 48, 30, 0.18); }
  .hub-card:nth-child(2) { background: radial-gradient(130% 100% at 85% 0%, rgba(199, 85, 61, 0.5), transparent 55%), linear-gradient(160deg, #7a3b2c, #4a2418 70%); }
  .hub-card:nth-child(3) { background: radial-gradient(130% 100% at 85% 0%, rgba(63, 178, 127, 0.45), transparent 55%), linear-gradient(160deg, #2f6b52, #1d4534 70%); }
  .hub-card:nth-child(4) { background: radial-gradient(130% 100% at 85% 0%, rgba(58, 110, 165, 0.5), transparent 55%), linear-gradient(160deg, #33547a, #1e3350 70%); }
  .hub-card:nth-child(5) { background: radial-gradient(130% 100% at 85% 0%, rgba(150, 106, 160, 0.4), transparent 55%), linear-gradient(160deg, #4d3a63, #2e2340 70%); }
  .hub-card:nth-child(6) { background: radial-gradient(130% 100% at 85% 0%, rgba(216, 129, 58, 0.45), transparent 55%), linear-gradient(160deg, #8a5a2c, #54341a 70%); }
  .hub-card.feat { flex: 2.4 1 560px; min-height: 400px; }
  .hub-card .bar {
    position: absolute; top: 16px; left: 16px; z-index: 3; width: 52px; height: 5px; border-radius: 3px;
    background: linear-gradient(90deg, #c7553d, #d8a13a, #3fb27f, #3a6ea5);
  }
  .hub-card .t { position: relative; z-index: 2; padding: 22px 24px; }
  .hub-card .eb { font: 600 12px/1.4 'Space Mono', ui-monospace, monospace; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 6px; opacity: 0.92; }
  .hub-card b { font-family: Fraunces, 'Noto Serif SC', serif; font-size: 22px; font-weight: 600; display: block; }
  .hub-card small { font-size: 13px; opacity: 0.88; display: block; margin-top: 4px; }

  .pfoot {
    border-top: 1px solid var(--line); padding: 26px 24px 34px;
    text-align: center; font-size: 12.5px; color: var(--ink-faint);
  }
  .pfoot a { color: var(--ink-soft); font-weight: 600; margin: 0 10px; }
</style>
