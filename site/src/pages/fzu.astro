---
/**
 * 福大重点页 —— 架构复刻自 HBEU 校园指南（动线叙事 + data-* 联动 + 三层视差）
 * 内容为原创福大校园生活向导；图片位预留（ph 渐变占位，可后续替换实拍）
 */
import Layout from '~/layouts/PageLayout.astro';

import '@fontsource/fraunces/300.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/700.css';

const metadata = {
  title: '福大新生动线',
  description: '福州大学新生第一天：35 分钟从校门到图书馆的动线导览。',
};

const routePoints = [
  {
    key: 'gate',
    time: '08:30',
    name: '校门报到',
    en: 'GATE',
    desc: '拖着行李箱在校门口报到点领材料、扫码入群。人流高峰在上午九点前，到得早就先在门口拍张照。',
  },
  {
    key: 'dorm',
    time: '09:10',
    name: '宿舍安顿',
    en: 'DORM',
    desc: '找到楼栋认领床铺，先铺床垫再拆行李。领空调遥控器和钥匙，记下宿管阿姨值班室的开放时间。',
  },
  {
    key: 'canteen',
    time: '11:30',
    name: '食堂开饭',
    en: 'CANTEEN',
    desc: '错峰午餐：11:30 之前人最少。先办饭卡圈存，一楼窗口打基础款，二楼留着你慢慢探索。',
  },
  {
    key: 'library',
    time: '14:00',
    name: '图书馆打卡',
    en: 'LIBRARY',
    desc: '下午去图书馆刷卡开通借阅权限，在靠窗位置坐一会——未来四年这里会是你在校园里待得最久的地方。',
  },
];

const atlasPoints = [
  {
    key: 'dorm',
    index: '01',
    title: '宿舍',
    en: 'DORMITORY',
    time: '生活起点',
    desc: '入住、收纳和每天出发的地方。先确认楼栋门禁时间、开水房和洗衣机的位置，室友的作息第一天就聊好。',
    x: 30,
    y: 30,
  },
  {
    key: 'library',
    index: '02',
    title: '图书馆',
    en: 'LIBRARY',
    time: '期末主战场',
    desc: '考试周的座位要赶早。研讨间可以预约，闭馆音乐响起前记得还书——借阅规则开学期初讲清楚。',
    x: 62,
    y: 24,
  },
  {
    key: 'canteen',
    index: '03',
    title: '食堂',
    en: 'CANTEEN',
    time: '干饭核心点',
    desc: '多个楼层多个风味窗口。高峰期 12 点，错峰 11:30 或 12:40；夜宵窗口是晚自习后的补给站。',
    x: 46,
    y: 62,
  },
  {
    key: 'gym',
    index: '04',
    title: '体育馆',
    en: 'GYM',
    time: '锻炼据点',
    desc: '体测、球类和健身房都在这一片。器械区傍晚最挤，早上人少空气好；场地预约看场馆公告。',
    x: 76,
    y: 66,
  },
];
---

<Layout metadata={metadata}>
  <div class="fzu-page" id="top">
    <!-- 入场片头 -->
    <div class="intro-splash" id="introSplash">
      <div class="intro-bg"></div>
      <div class="intro-center">
        <p class="mono intro-kicker">FZU · 2026 新生导览</p>
        <h2 class="intro-title">福州大学<em>新生动线</em></h2>
        <div class="intro-route mono">
          <span>校门</span><i></i><span>宿舍</span><i></i><span>食堂</span><i></i><span>图书馆</span>
        </div>
        <div class="intro-progress"><span id="introNumber">0%</span></div>
        <a class="intro-enter" id="introSkip" href="#hero">进入 →</a>
      </div>
    </div>

    <!-- 药丸导航 -->
    <nav class="pill-nav" aria-label="页面导航">
      <a href="#hero" data-pill-link>序</a>
      <a href="#route" data-pill-link>动线</a>
      <a href="#atlas" data-pill-link>沙盘</a>
      <a href="/cities/fuzhou" class="pill-out">← 福州</a>
    </nav>

    <!-- HERO：三层视差 -->
    <header class="hero" id="hero">
      <div class="hero-layer" data-speed="-0.08"></div>
      <div class="hero-layer mid" data-speed="-0.2"></div>
      <div class="hero-layer fore" data-speed="-0.42"></div>
      <div class="hero-content">
        <p class="mono hero-kicker r">FZU CAMPUS GUIDE · 旗山校区</p>
        <h1 class="r d1">第一天，<br /><em>不会迷路</em>的那种逛法</h1>
        <p class="hero-sub r d2">从校门到图书馆，一条 35 分钟的新生动线——照着走，报到日稳稳的。</p>
        <a class="btn r d3" href="#route">开始动线</a>
      </div>
      <div class="viewfinder" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    </header>

    <!-- ROUTE：新生一天 -->
    <section class="route-sec" id="route">
      <div class="frame-label"><span class="num">01</span><span class="bar"></span><span class="mono">ROUTE · 新生第一天</span></div>
      <div class="sec-head">
        <p class="kicker r">报到日动线</p>
        <h2 class="r d1">四个点，串成<em>第一天</em></h2>
      </div>

      <div class="route-body">
        <div class="album">
          {routePoints.map((p, i) => (
            <button
              class={`album-card ${i === 0 ? 'is-active' : ''}`}
              data-route-target={p.key}
              data-album-card
              style={`--x:${(i - 1.5) * 46}px;--y:${(i % 2 === 0 ? -1 : 1) * 22}px;--angle:${(i - 1.5) * 4}deg;--active-x:0px;--active-y:0px;--active-angle:0deg`}
            >
              <span class="album-ph">{p.name}</span>
              <span class="album-cap mono">{p.time} · {p.en}</span>
            </button>
          ))}
        </div>

        <div class="route-flow" data-route-flow data-active-route="gate">
          <svg class="route-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="route-line" data-route-svg d="M8,86 C30,70 20,40 46,40 S70,66 92,20" />
          </svg>
          <ol class="timeline">
            {routePoints.map((p, i) => (
              <li>
                <button
                  class={`route-point ${i === 0 ? 'is-route-active' : ''}`}
                  data-route-point={p.key}
                  data-route-index={i}
                >
                  <span class="rp-dot"></span>
                  <span class="rp-time mono">{p.time}</span>
                  <span class="rp-name">{p.name}</span>
                </button>
                <p class="rp-desc" data-route-desc={p.key}>{p.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ATLAS：生活沙盘 -->
    <section class="atlas-sec" id="atlas">
      <div class="frame-label"><span class="num">02</span><span class="bar"></span><span class="mono">ATLAS · 生活坐标</span></div>
      <div class="sec-head">
        <p class="kicker r">校园沙盘</p>
        <h2 class="r d1">四个<em>生活坐标</em></h2>
      </div>

      <div class="atlas-stage r" data-atlas-stage data-active-atlas="dorm">
        <div class="atlas-map">
          <span class="atlas-water">旗山湖</span>
          {atlasPoints.map((p) => (
            <button
              class={`atlas-point ${p.key === 'dorm' ? 'is-active' : ''}`}
              data-atlas-point={p.key}
              data-atlas-index={p.index}
              data-atlas-title={p.title}
              data-atlas-en={p.en}
              data-atlas-time={p.time}
              data-atlas-desc={p.desc}
              style={`--x:${p.x}%;--y:${p.y}%`}
            >
              <span class="atlas-dot"></span>
              <span class="atlas-label"><strong>{p.title}</strong><small>{p.en}</small></span>
            </button>
          ))}
        </div>
        <aside class="atlas-detail">
          <p class="mono ad-index" data-detail="index">01</p>
          <h3><span data-detail="title">宿舍</span><small data-detail="en">DORMITORY</small></h3>
          <p class="ad-time mono" data-detail="time">生活起点</p>
          <p class="ad-desc" data-detail="desc">入住、收纳和每天出发的地方。先确认楼栋门禁时间、开水房和洗衣机的位置，室友的作息第一天就聊好。</p>
          <div class="ad-chips">
            {atlasPoints.map((p) => (
              <button class={`ad-chip ${p.key === 'dorm' ? 'is-active' : ''}`} data-atlas-target={p.key} aria-pressed={p.key === 'dorm' ? 'true' : 'false'}>{p.title}</button>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <!-- 收尾 -->
    <section class="outro">
      <p class="kicker r">逛完校园</p>
      <h2 class="r d1">然后，去逛<em>福州</em></h2>
      <p class="r d2">三坊七巷、鼓山、闽江夜游——学校门口地铁直达。</p>
      <a class="btn r d3" href="/cities/fuzhou">福州城市指南 →</a>
    </section>

    <div class="viewfinder vf-fixed" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </div>
</Layout>

<style>
  .fzu-page {
    --ink: #0d1f1a; --ink-soft: #35544a; --paper: #f4f6f1;
    --acc: #0b70b6; --acc-soft: #b5e7f7; --gold: #e9c879; --cinnabar: #c8402f;
    --line: rgba(13, 31, 26, 0.14);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);

    color: var(--ink);
    background: var(--paper);
    font-family: Inter, ui-sans-serif, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    overflow-x: hidden;
  }
  .fzu-page a { color: inherit; text-decoration: none; }
  .fzu-page h1, .fzu-page h2, .fzu-page h3 { font-family: Fraunces, 'Noto Serif SC', Georgia, serif; }
  .mono { font-family: 'Space Mono', ui-monospace, monospace; letter-spacing: 0.16em; text-transform: uppercase; }
  .kicker { font-family: Fraunces, 'Noto Serif SC', serif; font-style: italic; color: var(--cinnabar); font-size: 17px; }
  .btn {
    display: inline-flex; padding: 14px 28px; border-radius: 999px; font-weight: 600; font-size: 14px;
    background: var(--acc); color: #fff; box-shadow: 0 14px 34px rgba(11, 112, 182, 0.3);
    transition: 0.3s var(--ease);
  }
  .btn:hover { transform: translateY(-2px); filter: brightness(1.08); }

  /* ===== 入场片头 ===== */
  .intro-splash {
    position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center;
    transition: opacity 1.1s var(--ease), visibility 1.1s;
  }
  .intro-splash.done { opacity: 0; visibility: hidden; pointer-events: none; }
  .intro-bg { position: absolute; inset: 0; background: radial-gradient(90% 90% at 70% 20%, #123f5e, #07141c 70%); }
  .intro-center { position: relative; text-align: center; color: #eaf6fd; }
  .intro-kicker { color: #9fd4f2; font-size: 11px; margin-bottom: 18px; }
  .intro-title { font-weight: 300; font-size: clamp(34px, 6vw, 72px); letter-spacing: -0.02em; }
  .intro-title em { font-style: italic; color: var(--acc-soft); }
  .intro-route { display: flex; align-items: center; gap: 12px; justify-content: center; margin: 28px 0 34px; font-size: 11px; color: #cfe8f8; }
  .intro-route i { width: 34px; height: 1px; background: linear-gradient(90deg, transparent, #6fb7dd, transparent); }
  .intro-progress { font-size: 13px; color: #9fd4f2; }
  .intro-progress span { font-variant-numeric: tabular-nums; }
  .intro-enter {
    display: inline-block; margin-top: 26px; padding: 10px 22px; border: 1px solid rgba(181, 231, 247, 0.5);
    border-radius: 999px; color: #eaf6fd; transition: 0.3s var(--ease);
  }
  .intro-enter:hover { background: rgba(181, 231, 247, 0.14); }

  /* ===== 药丸导航 ===== */
  .pill-nav {
    position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 100;
    display: flex; gap: 4px; padding: 6px; border-radius: 999px;
    background: rgba(13, 31, 26, 0.82); backdrop-filter: blur(12px);
    box-shadow: 0 18px 44px rgba(13, 31, 26, 0.3);
  }
  .pill-nav a {
    padding: 8px 16px; border-radius: 999px; font-size: 12.5px; font-weight: 600; color: #cfe3da; transition: 0.25s var(--ease);
  }
  .pill-nav a:hover, .pill-nav a.on { background: rgba(181, 231, 247, 0.18); color: #fff; }
  .pill-nav .pill-out { color: var(--gold); }

  /* ===== HERO 三层视差 ===== */
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden;
    background: #0d2430;
  }
  .hero-layer { position: absolute; inset: -12% 0; will-change: transform; }
  .hero-layer {
    background:
      radial-gradient(70% 60% at 78% 18%, rgba(11, 112, 182, 0.4), transparent 60%),
      radial-gradient(55% 55% at 20% 35%, rgba(233, 200, 121, 0.16), transparent 55%),
      linear-gradient(175deg, #123243 0%, #0d2430 55%, #081a22 100%);
  }
  .hero-layer.mid { background: radial-gradient(60% 42% at 50% 88%, rgba(9, 60, 88, 0.85), transparent 70%); }
  .hero-layer.fore { background: linear-gradient(180deg, transparent 55%, rgba(5, 14, 18, 0.88) 100%); }
  .hero-content { position: relative; z-index: 3; padding: 0 clamp(20px, 6vw, 80px) clamp(60px, 12vh, 120px); color: #eef8ff; max-width: 1080px; }
  .hero-kicker { color: var(--acc-soft); font-size: 11px; margin-bottom: 20px; }
  .hero h1 { font-size: clamp(44px, 8.4vw, 120px); line-height: 1; font-weight: 300; letter-spacing: -0.02em; }
  .hero h1 em { font-style: italic; color: var(--acc-soft); }
  .hero-sub { margin: 26px 0 34px; max-width: 520px; font-size: clamp(15px, 1.6vw, 18px); line-height: 1.75; color: rgba(234, 246, 253, 0.88); }
  .viewfinder i { position: absolute; width: 26px; height: 26px; border: 2px solid rgba(181, 231, 247, 0.55); }
  .viewfinder i:nth-child(1) { top: 86px; left: 22px; border-right: 0; border-bottom: 0; }
  .viewfinder i:nth-child(2) { top: 86px; right: 22px; border-left: 0; border-bottom: 0; }
  .viewfinder i:nth-child(3) { bottom: 86px; left: 22px; border-right: 0; border-top: 0; }
  .viewfinder i:nth-child(4) { bottom: 86px; right: 22px; border-left: 0; border-top: 0; }
  .vf-fixed { position: fixed; inset: 0; z-index: 90; pointer-events: none; }

  /* ===== 通用 section ===== */
  .route-sec, .atlas-sec { padding: clamp(90px, 14vh, 150px) clamp(20px, 6vw, 80px); max-width: 1280px; margin: 0 auto; }
  .frame-label { display: flex; align-items: center; gap: 14px; font-size: 11px; color: var(--ink-soft); margin-bottom: 34px; }
  .frame-label .num { color: var(--cinnabar); }
  .frame-label .bar { width: 48px; height: 3px; border-radius: 2px; background: linear-gradient(90deg, #6fb7dd, var(--acc)); }
  .sec-head { margin-bottom: 46px; }
  .sec-head h2 { font-size: clamp(32px, 5vw, 62px); font-weight: 300; line-height: 1.1; margin-top: 12px; }
  .sec-head h2 em { font-style: italic; color: var(--acc); }

  /* ===== ROUTE ===== */
  .route-body { display: grid; gap: 60px; }
  .album { position: relative; height: 300px; display: none; }
  .album-card {
    position: absolute; left: 50%; top: 50%;
    width: 200px; height: 260px; border: 0; border-radius: 16px; cursor: pointer;
    transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--angle));
    transition: transform 0.68s var(--ease), box-shadow 0.68s var(--ease);
    background: linear-gradient(160deg, #2c5a74, #123243);
    box-shadow: 0 18px 44px rgba(13, 31, 26, 0.28);
    display: grid; place-items: center; align-content: center; gap: 12px; color: #eef8ff;
  }
  .album-card.is-active { transform: translate(-50%, -50%) translate(var(--active-x), var(--active-y)) rotate(var(--active-angle)); z-index: 3; box-shadow: 0 30px 70px rgba(13, 31, 26, 0.4); }
  .album-ph { font-family: Fraunces, 'Noto Serif SC', serif; font-size: 22px; }
  .album-cap { font-size: 9px; color: var(--acc-soft); }
  @media (min-width: 900px) { .album { display: block; } }

  .route-flow { position: relative; }
  .route-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .route-line { fill: none; stroke: rgba(11, 112, 182, 0.35); stroke-width: 1.2; stroke-dasharray: 3 3; vector-effect: non-scaling-stroke; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; position: relative; }
  .timeline li { position: relative; padding: 14px 0 14px 0; }
  .route-point {
    display: flex; align-items: center; gap: 16px; width: 100%; text-align: left;
    background: none; border: 0; cursor: pointer; padding: 6px 10px; border-radius: 12px; transition: background 0.3s;
  }
  .route-point:hover { background: rgba(11, 112, 182, 0.06); }
  .rp-dot {
    width: 14px; height: 14px; border-radius: 50%; flex: none;
    background: #c9d8d0; border: 3px solid #fff; box-shadow: 0 0 0 1px var(--line);
    transition: all 0.35s var(--ease);
  }
  .route-point.is-route-active .rp-dot { background: var(--acc); box-shadow: 0 0 0 4px rgba(11, 112, 182, 0.2); }
  .rp-time { font-size: 11px; color: var(--ink-soft); min-width: 52px; }
  .rp-name { font-family: Fraunces, 'Noto Serif SC', serif; font-size: clamp(20px, 2.6vw, 30px); font-weight: 500; color: var(--ink); }
  .route-point.is-route-active .rp-name { color: var(--acc); }
  .rp-desc {
    margin: 4px 0 0 92px; max-width: 560px; font-size: 14.5px; line-height: 1.8; color: var(--ink-soft);
    display: none;
  }
  .rp-desc.show { display: block; }

  /* ===== ATLAS ===== */
  .atlas-stage {
    position: relative; display: grid; grid-template-columns: 1.4fr 1fr; gap: 0;
    border-radius: 20px; overflow: hidden; border: 1px solid var(--line);
    background: linear-gradient(180deg, #fdfffc, #eef3ee);
    box-shadow: 0 18px 44px rgba(13, 31, 26, 0.12);
    perspective: 1200px;
    transform: rotateX(0deg);
    transition: box-shadow 0.4s var(--ease);
  }
  .atlas-map {
    position: relative; min-height: 460px;
    background:
      repeating-linear-gradient(0deg, rgba(13, 31, 26, 0.05) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(90deg, rgba(13, 31, 26, 0.05) 0 1px, transparent 1px 44px),
      radial-gradient(40% 34% at 34% 70%, rgba(11, 112, 182, 0.14), transparent 70%),
      linear-gradient(180deg, #f7faf6, #edf2ec);
  }
  .atlas-water {
    position: absolute; left: 12%; bottom: 10%; font-family: Fraunces, 'Noto Serif SC', serif;
    font-size: 15px; letter-spacing: 0.3em; color: rgba(11, 112, 182, 0.4); font-style: italic;
  }
  .atlas-point {
    position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    background: none; border: 0; cursor: pointer; padding: 6px;
  }
  .atlas-dot {
    width: 16px; height: 16px; border-radius: 50%; background: #fff;
    border: 3px solid var(--acc); box-shadow: 0 0 0 4px rgba(11, 112, 182, 0.16);
    transition: all 0.35s var(--ease);
  }
  .atlas-point.is-active .atlas-dot { background: var(--acc); box-shadow: 0 0 0 8px rgba(11, 112, 182, 0.18); transform: scale(1.15); }
  .atlas-label { display: grid; justify-items: center; gap: 1px; }
  .atlas-label strong { font-size: 14px; color: var(--ink); }
  .atlas-label small { font-size: 8.5px; letter-spacing: 0.14em; color: var(--ink-soft); font-family: 'Space Mono', monospace; }
  .atlas-detail { padding: clamp(26px, 4vw, 44px); background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); border-left: 1px solid var(--line); display: flex; flex-direction: column; }
  .ad-index { font-size: 11px; color: var(--cinnabar); }
  .atlas-detail h3 { font-size: clamp(26px, 3vw, 40px); font-weight: 500; margin: 8px 0 4px; }
  .atlas-detail h3 small { display: block; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: 0.18em; color: var(--ink-soft); margin-top: 6px; }
  .ad-time { font-size: 10px; color: var(--acc); margin: 10px 0 14px; }
  .ad-desc { font-size: 14.5px; line-height: 1.85; color: var(--ink-soft); }
  .ad-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 22px; }
  .ad-chip {
    padding: 8px 15px; border-radius: 999px; border: 1px solid var(--line);
    background: #fff; font-size: 12.5px; color: var(--ink-soft); cursor: pointer; transition: 0.25s var(--ease);
  }
  .ad-chip.is-active { background: var(--acc); border-color: var(--acc); color: #fff; }
  @media (max-width: 860px) {
    .atlas-stage { grid-template-columns: 1fr; }
    .atlas-detail { border-left: 0; border-top: 1px solid var(--line); }
    .atlas-map { min-height: 380px; }
  }

  /* ===== 收尾 ===== */
  .outro { text-align: center; padding: clamp(80px, 12vh, 140px) 24px; background: linear-gradient(180deg, transparent, rgba(11, 112, 182, 0.06)); }
  .outro h2 { font-size: clamp(30px, 5vw, 58px); font-weight: 300; margin: 10px 0 14px; }
  .outro h2 em { font-style: italic; color: var(--acc); }
  .outro p { color: var(--ink-soft); margin-bottom: 28px; }

  /* ===== reveal ===== */
  .r { opacity: 0; transform: translateY(24px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); }
  .r.in { opacity: 1; transform: none; }
  .r.d1 { transition-delay: 0.1s; } .r.d2 { transition-delay: 0.2s; } .r.d3 { transition-delay: 0.3s; }
  @media (prefers-reduced-motion: reduce) {
    .r { opacity: 1; transform: none; transition: none; }
    .intro-splash { display: none; }
  }
</style>

<script>
  // ===== 入场片头（HBEU 配方压缩版：4.2s，可跳过） =====
  const splash = document.getElementById('introSplash');
  const num = document.getElementById('introNumber');
  const skip = () => splash?.classList.add('done');
  if (splash) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const skipped = new URLSearchParams(location.search).has('skipIntro');
    if (reduced || skipped) {
      skip();
    } else {
      const t0 = performance.now();
      const DUR = 4200;
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / DUR);
        const eased = 1 - Math.pow(1 - p, 3);
        if (num) num.textContent = Math.round(eased * 100) + '%';
        if (p < 1) requestAnimationFrame(tick);
        else skip();
      };
      requestAnimationFrame(tick);
      document.getElementById('introSkip')?.addEventListener('click', (e) => {
        e.preventDefault();
        skip();
        document.getElementById('hero')?.scrollIntoView({ behavior: 'instant' as ScrollBehavior });
      });
    }
  }

  // ===== reveal =====
  const io = new IntersectionObserver(
    (es) => {
      for (const e of es) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }
    },
    { threshold: 0.14, rootMargin: '0px 0px -8% 0px' }
  );
  const observeAll = () => document.querySelectorAll('.r:not(.in)').forEach((el) => io.observe(el));
  observeAll();
  setTimeout(observeAll, 400);

  // ===== HERO 三层视差（data-speed × scrollY，rAF 节流） =====
  const layers = Array.from(document.querySelectorAll<HTMLElement>('.hero-layer'));
  let ticking = false;
  const parallax = () => {
    const y = window.scrollY;
    for (const l of layers) {
      const s = parseFloat(l.dataset.speed || '0');
      l.style.transform = `translate3d(0, ${y * s}px, 0)`;
    }
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(parallax);
        ticking = true;
      }
    },
    { passive: true }
  );

  // ===== ROUTE 点位联动（同值多元素同步激活） =====
  const flow = document.querySelector<HTMLElement>('[data-route-flow]');
  const descs = document.querySelectorAll<HTMLElement>('[data-route-desc]');
  const setRoute = (key: string) => {
    if (!flow) return;
    flow.dataset.activeRoute = key;
    document.querySelectorAll('[data-route-point]').forEach((el) => {
      el.classList.toggle('is-route-active', (el as HTMLElement).dataset.routePoint === key);
    });
    document.querySelectorAll('[data-route-target]').forEach((el) => {
      el.classList.toggle('is-active', (el as HTMLElement).dataset.routeTarget === key);
    });
    descs.forEach((d) => d.classList.toggle('show', d.dataset.routeDesc === key));
  };
  document.querySelectorAll<HTMLElement>('[data-route-point]').forEach((btn) => {
    btn.addEventListener('click', () => setRoute(btn.dataset.routePoint!));
    btn.addEventListener('mouseenter', () => setRoute(btn.dataset.routePoint!));
  });
  document.querySelectorAll<HTMLElement>('[data-route-target]').forEach((card) => {
    card.addEventListener('click', () => setRoute(card.dataset.routeTarget!));
  });
  const firstPoint = document.querySelector<HTMLElement>('[data-route-point]');
  if (firstPoint) setRoute(firstPoint.dataset.routePoint!);

  // ===== ATLAS 沙盘联动（data-* 全字段驱动详情卡） =====
  const stage = document.querySelector<HTMLElement>('[data-atlas-stage]');
  const setAtlas = (btn: HTMLElement) => {
    if (!stage) return;
    stage.dataset.activeAtlas = btn.dataset.atlasPoint!;
    document.querySelectorAll('[data-atlas-point]').forEach((el) => {
      el.classList.toggle('is-active', el === btn);
    });
    document.querySelectorAll('[data-atlas-target]').forEach((el) => {
      const on = (el as HTMLElement).dataset.atlasTarget === btn.dataset.atlasPoint;
      el.classList.toggle('is-active', on);
      el.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    const q = (k: string) => document.querySelector(`[data-detail="${k}"]`);
    if (q('index')) q('index')!.textContent = btn.dataset.atlasIndex || '';
    if (q('title')) q('title')!.textContent = btn.dataset.atlasTitle || '';
    if (q('en')) q('en')!.textContent = btn.dataset.atlasEn || '';
    if (q('time')) q('time')!.textContent = btn.dataset.atlasTime || '';
    if (q('desc')) q('desc')!.textContent = btn.dataset.atlasDesc || '';
  };
  document.querySelectorAll<HTMLElement>('[data-atlas-point]').forEach((btn) => {
    btn.addEventListener('click', () => setAtlas(btn));
  });
  document.querySelectorAll<HTMLElement>('[data-atlas-target]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const target = document.querySelector<HTMLElement>(`[data-atlas-point="${chip.dataset.atlasTarget}"]`);
      if (target) setAtlas(target);
    });
  });

  // 沙盘微倾斜
  const mapEl = document.querySelector<HTMLElement>('.atlas-map');
  if (mapEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stageEl = document.querySelector<HTMLElement>('.atlas-stage');
    stageEl?.addEventListener('pointermove', (ev) => {
      const r = stageEl.getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width - 0.5;
      const y = (ev.clientY - r.top) / r.height - 0.5;
      stageEl.style.transform = `rotateX(${8 + y * -3}deg) rotateY(${x * 3}deg) rotateZ(-0.6deg)`;
    });
    stageEl?.addEventListener('pointerleave', () => {
      stageEl.style.transform = '';
    });
  }

  // 药丸导航高亮
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-pill-link]'));
  const sections = pills
    .map((a) => document.querySelector(a.getAttribute('href') || ''))
    .filter(Boolean) as Element[];
  const secIo = new IntersectionObserver(
    (es) => {
      for (const e of es) {
        if (e.isIntersecting) {
          pills.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
        }
      }
    },
    { threshold: 0.4 }
  );
  sections.forEach((s) => secIo.observe(s));
</script>
