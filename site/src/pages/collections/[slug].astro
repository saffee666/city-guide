---
/**
 * 主题榜单详情页 —— 结构 1:1 对齐 ChinaTravelCo collections.html（?list= 态）
 * hero（面包屑 + kicker + h1 + subtitle）+ intro 段 + rank-grid Top 10 排名卡
 * 图片位走源站同款 .img.ph 文字占位降级（后续换血实景图）
 */
import Layout from '~/layouts/PageLayout.astro';
import CardFX from '~/components/CardFX.astro';
import data from '~/data/collections.json';

export function getStaticPaths() {
  return Object.keys(data.collections).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = data.collections[slug!];
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const metadata = {
  title: `${c.title} | 主题榜单`,
  description: c.subtitle,
};
---

<Layout metadata={metadata}>
  <div class="col-page">
    <header class="hero">
      <div class="hero-inner">
        <nav class="crumb"><a href={`${B}/collections`}>主题榜单</a> / {c.title}</nav>
        <p class="kicker">精选合集</p>
        <h1>{c.title}</h1>
        <p>{c.subtitle}</p>
      </div>
    </header>

    <section class="section">
      <div class="wrap">
        <p class="intro">{c.intro}</p>
        <div class="rank-grid">
          {c.items.map((it, i) => (
            it.link ? (
              <a class="rc cardfx-target" href={it.link.startsWith('/') ? `${B}${it.link}` : it.link}>
                <div class={`img${it.img ? '' : ' ph'}`} data-ph={it.name}>
                  {it.img && <img src={it.img} alt={it.name} loading="lazy" />}
                </div>
                <span class="num">{i + 1}</span>
                <div class="body">
                  <span class="sub">{it.sub}</span>
                  <h3>{it.name}</h3>
                  <p>{it.blurb}</p>
                  <span class="go">打开指南 →</span>
                </div>
              </a>
            ) : (
              <div class="rc cardfx-target">
                <div class={`img${it.img ? '' : ' ph'}`} data-ph={it.name}>
                  {it.img && <img src={it.img} alt={it.name} loading="lazy" />}
                </div>
                <span class="num">{i + 1}</span>
                <div class="body">
                  <span class="sub">{it.sub}</span>
                  <h3>{it.name}</h3>
                  <p>{it.blurb}</p>
                </div>
              </div>
            )
          ))}
        </div>
      </div>
    </section>

    <footer class="pfoot">
      <a href={`${B}/`}>首页</a> · <a href={`${B}/collections`}>主题榜单</a> · <a href={`${B}/destinations`}>目的地</a>
      <br />© 2026 城市指南 · 数据仅供参考
    </footer>
  </div>
  <CardFX />
</Layout>

<style>
  .col-page {
    --paper: #f9f6ee; --card: #fffdf8;
    --ink: #211f1a; --ink-soft: #574f44; --ink-faint: #8a8275;
    --red: #c8402f; --red-deep: #a5311f; --tipbg: #fbf3ef;
    --line: rgba(33, 31, 26, 0.12); --radius: 18px;
    --shadow-sm: 0 2px 10px rgba(60, 55, 40, 0.07);
    color: var(--ink);
    background: linear-gradient(180deg, #fbf8f1, var(--paper) 55%, #f4f1e8);
    font-family: Inter, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  .col-page a { text-decoration: none; color: inherit; }

  .hero {
    position: relative; min-height: 46vh; display: flex; align-items: flex-end;
    color: #fff;
    background:
      radial-gradient(120% 90% at 80% 0%, rgba(216, 161, 58, 0.3), transparent 55%),
      radial-gradient(110% 80% at 12% 8%, rgba(63, 178, 127, 0.25), transparent 52%),
      linear-gradient(160deg, #2c4a68, #22436a 55%, #173250);
  }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.62)); }
  .hero-inner { position: relative; z-index: 2; width: 100%; max-width: 1180px; margin: 0 auto; padding: 120px 28px 46px; }
  .crumb { font-size: 13px; color: #fff; opacity: 0.9; margin: 0 0 14px; }
  .crumb a:hover { text-decoration: underline; }
  .kicker { font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.95; margin: 0 0 8px; }
  .hero h1 { font-family: Fraunces, 'Noto Serif SC', serif; font-weight: 600; font-size: clamp(34px, 5.4vw, 52px); margin: 0 0 10px; }
  .hero p { font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0; opacity: 0.95; }

  .section { padding: 56px 0; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
  .intro { font-size: 17px; color: var(--ink-soft); max-width: 820px; margin: 0 0 34px; line-height: 1.8; }

  .rank-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
  @media (max-width: 768px) { .rank-grid { grid-template-columns: 1fr; } }

  .rc {
    position: relative; border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--card); box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column; transition: transform .25s;
  }
  .rc:hover { transform: translateY(-4px); }
  .rc .img {
    position: relative; aspect-ratio: 16/10; overflow: hidden;
    background: linear-gradient(150deg, #3a6ea5, #22436a);
  }
  .rc:nth-child(3n) .img { background: linear-gradient(150deg, #2f6b52, #1d4534); }
  .rc:nth-child(3n + 1) .img { background: linear-gradient(150deg, #7a3b2c, #4a2418); }
  .rc .img.ph { display: grid; place-items: center; color: #fff; }
  .rc .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .rc .img.ph::after {
    content: attr(data-ph); font-family: 'Noto Serif SC', serif;
    font-size: 15px; font-weight: 600; opacity: 0.85; padding: 0 16px; text-align: center;
  }
  .num {
    position: absolute; top: 12px; left: 12px; z-index: 2; width: 38px; height: 38px;
    border-radius: 10px; background: var(--red); color: #fff; font-weight: 700;
    display: grid; place-items: center; font-size: 18px; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }
  .rc .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .rc .sub {
    font-size: 12.5px; font-weight: 600; color: var(--red-deep); background: var(--tipbg);
    align-self: flex-start; padding: 3px 9px; border-radius: 999px;
  }
  .rc h3 { font-family: Fraunces, 'Noto Serif SC', serif; font-size: 19px; font-weight: 600; margin: 0; }
  .rc p { color: var(--ink-soft); margin: 2px 0 0; font-size: 14.5px; line-height: 1.75; }
  .rc .go { margin-top: auto; font-size: 13px; font-weight: 600; color: var(--red); padding-top: 6px; }
  a.rc:hover .go { text-decoration: underline; }

  .pfoot {
    border-top: 1px solid var(--line); padding: 26px 24px 34px;
    text-align: center; font-size: 12.5px; color: var(--ink-faint);
  }
  .pfoot a { color: var(--ink-soft); font-weight: 600; margin: 0 10px; }
</style>
